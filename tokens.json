  "button": {
    "sizes": {
      "large": {
        "height": 54,
        "paddingX": 24,
        "radius": 12,
        "label": "Label/XLarge/Medium"
      },
      "small": {
        "height": 32,
        "paddingX": 12,
        "radius": 8,
        "label": "Label/Medium/Medium"
      }
    },
    "gap": 4,
    "ledge": 3,
    "variants": {
      "primary/default": {
        "fill": "{color/action/default}",
        "border": "{color/action/ledge}",
        "ledge": "{color/action/ledge}",
        "label": "{color/text/on-action}"
      },
      "primary/destructive": {
        "fill": "{color/danger/default}",
        "border": "{color/danger/ledge}",
        "ledge": "{color/danger/ledge}",
        "label": "{color/text/on-action}"
      },
      "secondary/default": {
        "fill": "{color/surface/action-subtle}",
        "border": "{color/border/action}",
        "ledge": "{color/border/action}",
        "label": "{color/text/action}"
      },
      "secondary/destructive": {
        "fill": "{color/surface/danger-subtle}",
        "border": "{color/border/danger}",
        "ledge": "{color/border/danger}",
        "label": "{color/text/danger}"
      },
      "tertiary/default": {
        "label": "{color/text/action}"
      },
      "tertiary/destructive": {
        "label": "{color/text/danger}"
      },
      "tertiary/neutral": {
        "label": "{grey/07}"
      }
    },
    "states": {
      "pressed": "translate down 3px, ledge removed (32ms ease-out); tertiary fades to 60%",
      "disabled": {
        "primary": {
          "fill": "{color/disabled/default}",
          "border": "{color/disabled/ledge}",
          "ledge": "{color/disabled/ledge}",
          "label": "{white}"
        },
        "secondary": {
          "fill": "{color/surface/subtle}",
          "border": "{color/border/strong}",
          "ledge": "{color/border/strong}",
          "label": "{color/text/tertiary}"
        },
        "tertiary": {
          "label": "{color/text/tertiary}"
        }
      },
      "loading": "light sweep across the button, 1s loop"
    }
  }
